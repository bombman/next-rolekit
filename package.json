{
  "name": "next-rolekit",
  "version": "0.1.0",
  "description": "Role & Permission guard library for Next.js 15 (App Router, Middleware, Supabase-ready)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist"
  },
  "keywords": [
    "nextjs",
    "role",
    "permission",
    "guard",
    "middleware",
    "supabase",
    "nextjs15",
    "authorization"
  ],
  "author": "Nuttapong Maneenate",
  "license": "MIT",
  "peerDependencies": {
    "next": ">=15.0.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.0",
    "eslint": "^9.25.1",
    "next": "^15.3.1",
    "prettier": "^3.5.3",
    "react": "^19.1.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "jose": "^6.0.10"
  },
  "dependencies": {}
}
