{
    "compilerOptions": {
      "target": "ESNext",
      "module": "ESNext",
      "jsx": "react-jsx",
      "moduleResolution": "Node",
      "resolveJsonModule": true,    
      "declaration": true,
      "outDir": "dist",
      "rootDir": "src",
      "baseUrl": "./src",
      "paths": {
        "@/*": ["./*"]
      },
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true
    },
    "include": ["src"]
  }
  